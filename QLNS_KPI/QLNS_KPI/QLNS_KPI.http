@QLNS_KPI_HostAddress = http://localhost:5145
@token = replace-with-jwt

POST {{QLNS_KPI_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "123456"
}

###

GET {{QLNS_KPI_HostAddress}}/api/bootstrap
Authorization: Bearer {{token}}
Accept: application/json

